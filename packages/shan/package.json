{
  "name": "shan",
  "version": "0.1.0",
  "description": "A visual agent editor for selecting, drawing on, animating, and changing Next.js interfaces",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js"
    },
    "./motion/next": {
      "types": "./dist/motion-next.d.ts",
      "import": "./dist/motion-next.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "dev": "tsup --watch",
    "prepublishOnly": "bun run test && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.72",
    "ai": "^7.0.111",
    "diff": "^8.0.2",
    "effect": "4.0.0-rc.117",
    "fast-glob": "^3.3.3"
  },
  "peerDependencies": {
    "next": ">=15.0.0 <17",
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.18.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
